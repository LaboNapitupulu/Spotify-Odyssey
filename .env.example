# PostgreSQL connection string. Use sslmode=require for hosted providers.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Spotify application credentials.
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/

# Public origins allowed to call the API, separated by commas.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Private Spotify endpoints are disabled by default.
ENABLE_LIVE_SPOTIFY=false

# Required when live endpoints are exposed beyond localhost.
PRIVATE_API_KEY=replace_with_a_long_random_value

# PostgreSQL connection pool size.
DB_POOL_MIN=1
DB_POOL_MAX=5
